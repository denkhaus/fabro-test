digraph Probe32ObservationRecord {
    graph [goal="A granted stage records one observation and the entry reaches the run stream", default_max_retries=0, stall_timeout="5m"]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    recorder [
        label="Recorder: one durable observation",
        prompt="@prompts/recorder.md",
        max_visits=3,
        x.observations="required",
        x.fabro_tools="fabro_observation_record",
        x.tools="read_file"
    ]
    start -> recorder -> exit
}
