digraph ObservationCliProbe {
    graph [
        goal="Stage self-awareness and the observation CLI door: a command stage records through the channel with its engine-bound identity (ADR-0039 stage C, denkhaus/work#1107)",
        default_max_retries=0,
        stall_timeout="5m"
    ]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    recorder [
        label="Recorder: the script-stage door",
        shape=parallelogram,
        script="nu .fabro/workflows/probe-37-observation-cli/scripts/probe.nu",
        timeout="120s",
        max_retries=0
    ]
    start -> recorder
    recorder -> exit [label="Done"]
}
