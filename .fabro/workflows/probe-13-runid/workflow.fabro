digraph Probe13Runid {
    graph [goal="A stage_complete hook context carries the run id", default_max_retries=0, stall_timeout="5m"]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    emit [
        label="Emit: trigger the hook",
        shape=parallelogram,
        script="nu -c \"print 'hook trigger'\"",
        timeout="30s",
        max_retries=0
    ]
    verify [
        label="Verify: run id in journal",
        shape=parallelogram,
        script="nu .fabro/workflows/probe-13-runid/scripts/verify.nu",
        output_schema="routing",
        timeout="30s",
        max_retries=0
    ]
    start -> emit -> verify
    verify -> exit [label="Runid ok"]
}
