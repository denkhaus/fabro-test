digraph AdjudicatorReadsProbe {
    graph [
        goal="The adjudicator's four read doors over the run channel — queue, facts, radius, comments — as the same argv the fast-path script drives (ADR-0039 stage D part 2, denkhaus/work#1107)",
        default_max_retries=0,
        stall_timeout="5m"
    ]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    reader [
        label="Reader: the four read doors",
        shape=parallelogram,
        script="nu .fabro/workflows/probe-39-adjudicator-reads/scripts/probe.nu",
        timeout="120s",
        max_retries=0
    ]
    start -> reader
    reader -> exit [label="Done"]
}
