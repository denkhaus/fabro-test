digraph Probe27GhAbsent {
    graph [goal="The toolchain run sandbox carries no gh binary (ADR-0019)", default_max_retries=0, stall_timeout="5m"]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    check [
        label="Check: gh absent in the sandbox",
        shape=parallelogram,
        script="command -v gh >/dev/null 2>&1 && { echo 'gh IS present - the ADR-0019 property flipped; the fail-open arms in dup-run-check/prompt-lint become dead code'; exit 1; } || { echo 'gh absent (ADR-0019)'; exit 0; }",
        timeout="30s",
        max_retries=0
    ]
    start -> check
    check -> exit [label="Gh absent"]
}
