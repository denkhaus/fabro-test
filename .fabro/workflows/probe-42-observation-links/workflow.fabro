digraph Probe42ObservationLinks {
    graph [goal="The work-item observation link lifecycle on the wire: link shows in the list, dedupes at the edge, unlink empties the radius", default_max_retries=0, stall_timeout="5m"]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    recorder [
        label="Recorder: one note observation",
        prompt="@prompts/recorder.md",
        max_visits=3,
        x.observations="required",
        x.fabro_tools="fabro_observation_record",
        x.tools="read_file"
    ]
    start -> recorder -> exit
}
