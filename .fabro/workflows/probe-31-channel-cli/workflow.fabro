digraph ChannelProbe {
    graph [
        goal="Drive the in-sandbox work CLI over the run channel socket: the exact evidence.nu path (work#1073 repro)",
        default_max_retries=0,
        stall_timeout="5m"
    ]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    probe [
        label="Probe: channel CLI + socket fs state",
        shape=parallelogram,
        script="nu .fabro/workflows/channel-probe/scripts/probe.nu",
        timeout="120s",
        max_retries=0
    ]
    start -> probe
    probe -> exit [label="Done"]
}
