digraph Probe30ThreeReds {
    graph [goal="The third consecutive gate red exits to the human instead of another round", default_max_retries=0, stall_timeout="5m", max_node_visits=20]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    tester [
        label="Tester: always red",
        shape=parallelogram,
        script="exit 1",
        timeout="30s",
        max_retries=0
    ]
    implementer [
        label="Implementer: cannot fix a red by design",
        shape=parallelogram,
        script="true",
        timeout="30s",
        max_retries=0
    ]
    start -> tester
    # The work#1057 shape (restored fabro-6baf guard): the bounce carries
    # the generation cap, so the third red matches no conditional edge and
    # lands on the unconditional deadlock fallback — the human exit. The
    # deadlock exit is the node's SOLE route to exit (fabro-843d
    # sole_exit_route: a plain gate-green -> exit edge beside the kind edge
    # would leave a success-shaped finish unclassified) — the same shape
    # the lane graphs have (their green route runs through evidence, never
    # a plain tester -> exit). The cap is 2, not 3, BY MEASUREMENT: with
    # < 3 the circuit breaker (loop_restart_signature_limit=3) cuts the
    # third loop signature workflow_error before a >= 3 guard can fire
    # (first drive, run 01M636T77HA3QSKK4F6G93AQFV: two bounces then
    # workflow_error at the third red). The bench asserts the run ends
    # FAILED with reason=deadlock — the human exit — NOT workflow_error,
    # NOT succeeded.
    tester -> implementer [label="Gate red", condition="outcome=failed && nodes.tester.generation < 2"]
    tester -> exit [x.kind="deadlock", label="Gate deadlock (3 reds, needs a human)"]
    implementer -> tester [label="Re-test"]
}
