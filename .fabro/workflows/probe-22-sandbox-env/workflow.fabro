digraph Probe22SandboxEnv {
    graph [goal="The run sandbox's environment and git identity state are captured as run evidence", default_max_retries=0, stall_timeout="5m"]
    start [shape=Mdiamond]
    exit  [shape=Msquare]
    capture [
        label="Capture: env + git identity state",
        shape=parallelogram,
        script="nu .fabro/workflows/probe-22-sandbox-env/scripts/capture.nu",
        timeout="90s",
        max_retries=0
    ]
    verify [
        label="Verify: evidence files present",
        shape=parallelogram,
        script="nu .fabro/workflows/probe-22-sandbox-env/scripts/verify.nu",
        output_schema="routing",
        timeout="60s",
        max_retries=0
    ]
    start -> capture -> verify
    verify -> exit [label="Env captured"]
}
