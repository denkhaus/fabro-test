digraph Mini {
    graph [
        goal="Implement one mini seed per run: claim, implement, gate, review, close",
        default_max_retries=0,
        max_node_visits=20,
        // 5-minute verdict line: 10m of total stall -> red, never a 20m hang.
        stall_timeout="10m",
        rankdir=LR
    ]

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // Deterministic drained-tracker fast exit (zero LLM tokens).
    // Fail-open: any error routes non-empty into the planner.
    tracker_guard [
        label="Tracker guard: empty-tracker fast exit",
        shape=parallelogram,
        script="python3 .fabro/workflows/mini/scripts/tracker_guard.py",
        output_schema="routing",
        timeout="30s",
        max_retries=0
    ]

    // Planner: claims THE ONE seed, hands a brief. Read-only agent;
    // the claim is pure context_updates (the Contract::Schema seam).
    planner [
        label="Planner",
        prompt="@prompts/planner.md",
        output_schema="@schemas/planner-output.schema.json",
        output_retries=2,
        max_visits=10,
        retry_policy="standard",
        x.preamble_stages_ignore="planner,implementer",
        x.tools="read_file,glob,grep",
        x.fs_write="",
        x.context_allow_keys="current_seed_id,current_seed_title,current_seed_brief"
    ]

    // Claim-contract gate: the engine resolves stdin_source from the
    // planner's context_updates before the script runs — a dropped
    // current_seed_id fails here in seconds, not after a full cycle.
    claim_check [
        label="Claim check: seed id contract",
        shape=parallelogram,
        script="python3 .fabro/workflows/mini/scripts/claim_check.py",
        stdin_source="current_seed_id",
        timeout="30s",
        max_retries=0
    ]

    // Implementer: broad-write envelope — fs_write UNSET (product paths
    // stay writable), loop assets hidden.
    implementer [
        label="Implementer",
        prompt="@prompts/implementer.md",
        output_schema="routing",
        output_retries=2,
        max_visits=10,
        retry_policy="standard",
        x.preamble_stages_ignore="planner,implementer,reviewer",
        x.preamble_stages_latest_only=true,
        x.preamble_allow_keys="current_seed_id,current_seed_title,current_seed_brief",
        x.tools="read_file,write_file,edit_file,glob,grep,shell",
        x.fs_hide=".fabro/**,.seeds/**",
        x.context_allow_keys="implementation_summary"
    ]

    // Deterministic gate: stdlib unittest, seconds not minutes.
    tester [
        label="Quality Gate",
        shape=parallelogram,
        script="python3 -m unittest discover -s tests -v",
        timeout="3m",
        max_retries=1
    ]

    // Evidence: the run's whole diff + commits for the reviewer.
    evidence [
        label="Evidence",
        shape=parallelogram,
        script="git --no-pager diff origin/main...HEAD; git --no-pager log --oneline origin/main..HEAD; git --no-pager status --porcelain",
        timeout="1m",
        max_retries=1
    ]

    // Reviewer: read-only by engine enforcement.
    reviewer [
        label="Reviewer",
        prompt="@prompts/reviewer.md",
        output_schema="routing",
        output_retries=2,
        max_visits=20,
        retry_policy="standard",
        x.preamble_stages_ignore="planner,implementer,reviewer",
        x.preamble_stages_latest_only=true,
        x.preamble_allow_keys="current_seed_id,current_seed_title,current_seed_brief,implementation_summary,command.output",
        x.preamble_inline_max_kb=16,
        x.tools="read_file,grep,glob",
        x.fs_write="",
        x.context_allow_keys="review_verdict,review_feedback"
    ]

    // Deterministic closeout: closes exactly this run's seed (stdin).
    closeout [
        label="Closeout",
        shape=parallelogram,
        script="python3 .fabro/workflows/mini/scripts/closeout.py",
        stdin_source="current_seed_id",
        timeout="1m",
        max_retries=1
    ]

    start -> tracker_guard
    tracker_guard -> exit [label="Tracker empty", condition="preferred_label=\"Tracker empty\""]
    tracker_guard -> planner [label="Tracker non-empty"]

    planner -> exit [label="Tracker empty", condition="preferred_label=\"Tracker empty\""]
    planner -> exit [x.kind="deadlock", label="Blocked", condition="preferred_label=\"Blocked\""]
    planner -> claim_check [label="Seed claimed"]
    claim_check -> implementer [label="Seed id present"]
    claim_check -> planner [label="Claim contract failed, re-plan", condition="outcome=failed"]

    implementer -> planner [label="Blocked", condition="outcome=failed"]
    implementer -> tester [label="Implemented"]

    tester -> evidence [label="Gate green", condition="outcome=succeeded"]
    tester -> exit [x.kind="deadlock", label="Gate deadlock (3 reds, needs a human)", condition="nodes.tester.generation >= 3"]
    tester -> implementer [label="Gate red"]

    evidence -> reviewer [label="Evidence ready", condition="outcome=succeeded"]
    evidence -> exit [x.kind="soft", label="Capture failed (next run re-enters)"]

    reviewer -> closeout [label="Approved", condition="preferred_label=\"Approved\""]
    reviewer -> exit [x.kind="deadlock", label="Review deadlock (3 cycles, needs a human)", condition="nodes.reviewer.generation >= 3"]
    reviewer -> planner [label="Changes requested"]
    reviewer -> exit [x.kind="soft", label="Reviewer failed (next run re-enters)", condition="outcome=failed"]

    closeout -> exit [label="Seed closed"]
    closeout -> exit [x.kind="soft", label="Closeout failed (seed stays open)", condition="outcome=failed"]
}
